* {
    bg:         #181825;
    bg-alt:     #1e1e2e;
    fg:         #ffffff;
    fg-muted:   #7f849c;
    selected:   #313244;
    accent:     #89b4fa;

    background-color: transparent;
    text-color: @fg;
    font: "Terminess Nerd Font 12";
}

window {
    width: 520px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 0px;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    background-color: @bg-alt;
    padding: 8px 12px;
    border: 1px;
    border-color: @selected;
    border-radius: 0px;
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-muted;
}

listview {
    lines: 6;
    spacing: 4px;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 8px 10px;
    border-radius: 0px;
    spacing: 10px;
    text-color: @fg;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
    border: 0px 0px 0px 2px;
    border-color: @accent;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
