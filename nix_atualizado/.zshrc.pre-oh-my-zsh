# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.

### History
HISTSIZE=10000
SAVEHIST=20000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt INC_APPEND_HISTORY

### Completion system
autoload -Uz compinit
compinit

# TAB completion from history + normal completion
zstyle ':completion:*' completer _complete _history
zstyle ':completion:*' menu select

# fzf (zsh)
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh

alias ls='ls --color=auto'
alias grep='grep --color=auto'

export PATH="$PATH:/opt/nvim-linux-x86_64/bin:$HOME/.bun/bin"
alias vi='nvim'
alias makeit='sudo make clean install'
alias thomasfsr='sudo chown -R thomasfsr:thomasfsr .'
alias clrvi='rm -rf ~/.cache/nvim ~/.local/share/nvim ~/.local/state/nvim'
alias sx='startx'
alias clean_pacman_cache='sudo pacman -Scc'

PS1='[%n@%m %1~]%# '

# bun completions
[ -s "/home/thomasfsr/.bun/_bun" ] && source "/home/thomasfsr/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# . "$HOME/.local/bin/env"

eval "$(starship init zsh)"

# opencode
export PATH=/home/thomasfsr/.opencode/bin:$PATH

# ZVM
export ZVM_INSTALL="$HOME/.zvm/self"
export PATH="$PATH:$HOME/.zvm/bin"
export PATH="$PATH:$ZVM_INSTALL/"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/thomasfsr/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/thomasfsr/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/thomasfsr/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/thomasfsr/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<


# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE='/home/thomasfsr/miniforge3/bin/mamba';
export MAMBA_ROOT_PREFIX='/home/thomasfsr/miniforge3';
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<
export GTK_THEME=catppuccin-mocha-lavender-standard+default
export GTK_THEME=catppuccin-mocha-lavender-standard+default

# opencode
export PATH=/home/tfsr/.opencode/bin:$PATH

# Composer (o package manager do PHP)
export PATH="$HOME/.config/composer/vendor/bin:$PATH"
